CONFIG_IDF_TARGET="esp32c61"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_TIMESTAMP_SOURCE_SYSTEM=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# C61 internal RAM is too tight for TLS after Wi-Fi; use heap malloc (PSRAM for large).
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_ESP_WIFI_NVS_ENABLED=y
CONFIG_LWIP_MAX_SOCKETS=12
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=n
# Allow MQTTS "verify off" (no CA). OTA still attaches CRT bundle and verifies.
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y
# C61HR2 has 2MB PSRAM — required for MQTTS (TLS) after Wi-Fi is up
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Prefer PSRAM for >=1KB allocs so MQTT/WiFi buffers leave internal for task stacks.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Keep Wi-Fi buffer footprint small so SoftAP beacon (min 752B internal) can alloc under APSTA.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=6

# NimBLE BSS on C61 (~27KB+ internal) breaks SoftAP httpd even after
# esp_bt_controller_mem_release(). SoftAP-capable default: BT off.
# PAGE-hold BLE window code is present; enable via sdkconfig.ble_prov when
# building a BLE-boot image (dual-image / SKU), not in the SoftAP default.
# CONFIG_BT_ENABLED is not set
# CONFIG_ESP_COEX_SW_COEXIST_ENABLE is not set



# C61 Rev1: task stacks in PSRAM break mqtt/TLS task create — keep stacks internal.
# CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY is not set
# CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM is not set
